{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"]
    },
    "target": "ES2022",
    "types": ["node", "vite/client", "void/env"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".void/**/*.d.ts"],
  "exclude": ["node_modules", "dist", ".next", ".open-next", ".void/build"]
}
